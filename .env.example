# Leave unset while evaluating previews. No API keys are required.
# After a separately approved launch, use your owned, connected HTTPS origin.
# No path, query, fragment, credentials, or non-default port.
# Placeholder domains, IPs, and known platform preview hostnames are rejected.
SITE_URL=
# Build-time opt-in only after reviewing docs/LAUNCH.md. A URL alone is not a launch.
# Non-production VERCEL_ENV values still force noindex and omit public URLs.
ALLOW_INDEXING=false
